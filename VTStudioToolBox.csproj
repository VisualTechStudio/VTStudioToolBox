		<!-- 子目录工具 - hwinfo -->
		<Content Include="Tools\hwinfo\HWiNFO64.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Tools\hwinfo\**\*.dll">
