		<Content Include="Tools\CrystalDiskMark\**\*.ini">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Tools\CrystalDiskMark\CdmResource\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- 子目录工具 - CrystalDiskInfo -->
		<Content Include="Tools\CrystalDiskInfo\DiskInfo32S.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Tools\CrystalDiskInfo\DiskInfo64S.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Tools\CrystalDiskInfo\**\*.ini">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Tools\CrystalDiskInfo\CdiResource\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Tools\CrystalDiskInfo\Smart\**\*.*">
