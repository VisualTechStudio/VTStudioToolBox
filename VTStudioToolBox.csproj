		</Content>
		<!-- 子目录工具 - GPUZ -->
		<Content Include="Tools\GPUZ\GPU-Z.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- 子目录工具 - FurMark -->
		<Content Include="Tools\FurMark\FurMark.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Tools\FurMark\**\*.dll">
