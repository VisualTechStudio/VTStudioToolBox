<Page
    x:Class="VTStudioToolBox.Views.UtilitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">

    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="实用工具"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="许哥牛逼。"
                           FontSize="16"
                           Foreground="#CCCCCC"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="24">
                <!-- 硬件检测 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="硬件检测"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#4FC3F7"/>
                    
                    <StackPanel Spacing="12">
                        <!-- CPU-Z -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="CpuZIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CPU-Z"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="查看详细的CPU、主板、内存信息"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchCpuZ"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchCpuZ_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Core Temp -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="CoreTempIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Core Temp"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="实时监控CPU温度"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchCoreTemp"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchCoreTemp_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- AIDA64 -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="AIDA64Icon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="AIDA64"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="全面的系统诊断和基准测试"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchAIDA64"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchAIDA64_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- HWiNFO -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="HWiNFOIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="HWiNFO"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="专业的硬件信息和诊断工具"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchHWiNFO"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchHWiNFO_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- GPU-Z -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="GPUZIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="GPU-Z"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="查看详细的显卡信息"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchGPUZ"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchGPUZ_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- FurMark -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="FurMarkIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="FurMark"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="显卡压力测试和烤机工具"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchFurMark"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchFurMark_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 鲁大师 -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="LuDaShiIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="鲁大师"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="硬件检测、性能测试、驱动管理"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchLuDaShi"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchLuDaShi_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- MonitorInfo -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="MonitorInfoIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MonitorInfo"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="查看显示器详细信息和色域"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchMonitorInfo"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchMonitorInfo_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 磁盘工具 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="磁盘工具"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#81C784"/>
                    
                    <StackPanel Spacing="12">
                        <!-- CrystalDiskMark -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="DiskMarkIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CrystalDiskMark"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="硬盘性能测试工具"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchDiskMark"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchDiskMark_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- CrystalDiskInfo -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="DiskInfoIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CrystalDiskInfo"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="硬盘健康状态检测工具"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchDiskInfo"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchDiskInfo_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- DiskGenius -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="DiskGeniusIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="DiskGenius"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="磁盘分区管理和数据恢复工具"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchDiskGenius"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchDiskGenius_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- SpaceSniffer -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="SpaceSnifferIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SpaceSniffer"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="磁盘空间可视化分析工具"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchSpaceSniffer"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchSpaceSniffer_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 系统工具 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="系统工具"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#FFB74D"/>
                    
                    <StackPanel Spacing="12">
                        <!-- Dism++ -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="DismIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Dism++"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="Windows系统清理和优化工具"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchDism"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchDism_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Geek Uninstaller -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="GeekIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Geek Uninstaller"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="强力卸载工具，深度清理残留"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchGeek"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchGeek_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- HEU KMS Activator -->
                        <Border Background="#2D2D2D"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       x:Name="KMSIcon"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="HEU KMS Activator"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="Windows和Office激活工具"
                                               FontSize="14"
                                               Foreground="#CCCCCC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnLaunchKMS"
                                        Grid.Column="2"
                                        Content="启动"
                                        Click="BtnLaunchKMS_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
