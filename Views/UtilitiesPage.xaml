<Page
    x:Class="VTStudioToolBox.Views.UtilitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">

    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="24">
                <!-- 硬件检测 -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HardwareHeader" Foreground="{StaticResource SectionBlueBrush}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel x:Name="HardwareTools" Spacing="12"/>
                </StackPanel>

                <!-- 磁盘工具 -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="DiskHeader" Foreground="{StaticResource SectionGreenBrush}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel x:Name="DiskTools" Spacing="12"/>
                </StackPanel>

                <!-- 系统工具 -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SystemHeader" Foreground="{StaticResource SectionOrangeBrush}"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel x:Name="SystemTools" Spacing="12"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
