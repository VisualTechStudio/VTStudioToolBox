<Page
    x:Class="VTStudioToolBox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">

    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="PageTitle" Style="{ThemeResource PageTitleStyle}"/>
                <TextBlock x:Name="PageSubtitle" Style="{ThemeResource PageSubtitleStyle}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 语言设置 -->
                <Border Grid.Row="0" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="LanguageHeader" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                        <ComboBox x:Name="LanguageComboBox"
                                  MinWidth="140"
                                  VerticalAlignment="Center"
                                  SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <!-- 主题设置 -->
                <Border Grid.Row="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ThemeHeader" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                        <ComboBox x:Name="ThemeComboBox"
                                  MinWidth="140"
                                  VerticalAlignment="Center"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="ThemeSystemOption" Tag="System"/>
                            <ComboBoxItem x:Name="ThemeDarkOption" Tag="Dark"/>
                            <ComboBoxItem x:Name="ThemeLightOption" Tag="Light"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 隐私设置 -->
                <Border Grid.Row="2" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="PrivacyHeader" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                        <ToggleSwitch x:Name="AnalyticsToggle"
                                      IsOn="False"
                                      IsEnabled="False"
                                      OffContent=""
                                      OnContent=""/>
                        <TextBlock x:Name="AnalyticsDescription"
                                   FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 日志设置 -->
                <Border Grid.Row="3" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="LogHeader" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="LogLevelLabel" FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="LogLevelComboBox"
                                      Width="120"
                                      VerticalAlignment="Center"
                                      SelectionChanged="LogLevelComboBox_SelectionChanged">
                                <ComboBoxItem Content="Dev" Tag="0"/>
                                <ComboBoxItem Content="Info" Tag="1" IsSelected="True"/>
                                <ComboBoxItem Content="Warn" Tag="2"/>
                                <ComboBoxItem Content="Error" Tag="3"/>
                            </ComboBox>
                            <Button x:Name="FeedbackButton"
                                    Click="FeedbackButton_Click"
                                    FontSize="12" BorderThickness="1" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE946;" FontSize="12"/>
                                    <TextBlock x:Name="FeedbackButtonText"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="AboutHeader" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,16"/>

                        <StackPanel Spacing="8" Margin="0,0,0,16">
                            <TextBlock Text="VTStudio ToolBox" FontSize="14"
                                       Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="VersionTextBlock" FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="CopyrightText"
                                       FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="GPLStatement"
                                       FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="WebsiteButton" Click="WebsiteButton_Click"
                                    FontSize="12" BorderThickness="1" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontSize="12"/>
                                    <TextBlock x:Name="WebsiteButtonText"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GitHubButton" Click="GitHubButton_Click"
                                    FontSize="12" BorderThickness="1" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE734;" FontSize="12"/>
                                    <TextBlock x:Name="GitHubButtonText"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GPLV3Button" Click="GPLV3Button_Click"
                                    FontSize="12" BorderThickness="1" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70B;" FontSize="12"/>
                                    <TextBlock x:Name="GPLButtonText"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RevokeEulaButton" Content="撤销同意用户协议"
                                    Click="RevokeEulaButton_Click" FontSize="12"
                                    Foreground="{ThemeResource DangerRedBrush}"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource DangerRedBrush}"
                                    BorderThickness="1" Padding="12,6"/>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16,0,12"/>

                        <TextBlock x:Name="ContributorsHeader" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                        <StackPanel Spacing="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="64" Height="64" Grid.Column="0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Assets/dwg.png" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Stroke>
                                        <ThemeResource ResourceKey="AvatarStrokeBrush"/>
                                    </Ellipse.Stroke>
                                    <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="KL_Xydwg01" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="ContributorRole_Dwg"
                                               FontSize="12" Foreground="{ThemeResource TertiaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="64" Height="64" Grid.Column="0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Assets/xcy.png" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Stroke>
                                        <ThemeResource ResourceKey="AvatarStrokeBrush"/>
                                    </Ellipse.Stroke>
                                    <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Shayne Hui" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="ContributorRole_Xcy"
                                               FontSize="12" Foreground="{ThemeResource TertiaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="64" Height="64" Grid.Column="0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Assets/kpdw.png" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Stroke>
                                        <ThemeResource ResourceKey="AvatarStrokeBrush"/>
                                    </Ellipse.Stroke>
                                    <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="月" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="ContributorRole_Yue"
                                               FontSize="12" Foreground="{ThemeResource TertiaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16,0,12"/>

                        <TextBlock x:Name="ContributionsHeader" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="ContributionsIntro"
                                   FontSize="12" Foreground="{ThemeResource FaintTextBrush}"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <StackPanel x:Name="ContributionsStack" Spacing="8"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ChangelogHeader" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="LogTextBlock" FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
