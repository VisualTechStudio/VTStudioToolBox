<Page
    x:Class="VTStudioToolBox.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">

    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Header with Welcome -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="PageTitle" Style="{ThemeResource PageTitleStyle}"/>
                <TextBlock x:Name="PageSubtitle" Style="{ThemeResource PageSubtitleStyle}"/>
            </StackPanel>

            <!-- Two-column content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: Model+Manufacturer + HardwareInfo -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Model + Manufacturer card -->
                    <Border x:Name="DeviceCardBorder" Grid.Row="0" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DeviceManufacturerText"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{ThemeResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="DeviceMotherboardText"
                                       FontSize="14"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Hardware Info card -->
                    <Border x:Name="LoadingBorder" Grid.Row="1" Style="{ThemeResource CardBorderStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <muxc:ProgressRing IsActive="True" Width="20" Height="20" Margin="0,0,16,0"/>
                            <TextBlock x:Name="LoadingText"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HardwareInfoBorder" Grid.Row="1" Style="{ThemeResource CardBorderStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="HardwareInfoHeader" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LabelManufacturer" Grid.Row="0" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="HardwareManufacturerText" Grid.Row="0" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelMotherboard" Grid.Row="1" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="MotherboardText" Grid.Row="1" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelModel" Grid.Row="2" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="HardwareModelText" Grid.Row="2" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelCPU" Grid.Row="3" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="HardwareCPUText" Grid.Row="3" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelRAM" Grid.Row="4" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="RAMText" Grid.Row="4" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelGPU" Grid.Row="5" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="HardwareGPUText" Grid.Row="5" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelDisk" Grid.Row="6" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="HDDText" Grid.Row="6" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelNIC" Grid.Row="7" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="NetworkText" Grid.Row="7" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelAudio" Grid.Row="8" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                                <TextBlock x:Name="AudioText" Grid.Row="8" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                                <TextBlock x:Name="LabelMonitor" Grid.Row="9" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}" Margin="0,0,12,0"/>
                                <TextBlock x:Name="DisplayText" Grid.Row="9" Grid.Column="1" Style="{ThemeResource InfoValueStyle}" Margin="0,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right column: System Info + Monitor -->
                <StackPanel Grid.Column="2">
                <Border x:Name="SystemInfoBorder" Style="{ThemeResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SystemInfoHeader" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LabelName" Grid.Row="0" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                            <TextBlock x:Name="SystemComputerNameText" Grid.Row="0" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                            <TextBlock x:Name="LabelSystem" Grid.Row="1" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                            <TextBlock x:Name="SystemInfoText" Grid.Row="1" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                            <TextBlock x:Name="LabelInstallTime" Grid.Row="2" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}"/>
                            <TextBlock x:Name="SystemInstallTimeText" Grid.Row="2" Grid.Column="1" Style="{ThemeResource InfoValueStyle}"/>

                            <TextBlock x:Name="LabelUptime" Grid.Row="3" Grid.Column="0" Style="{ThemeResource InfoLabelStyle}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SystemBootTimeText" Grid.Row="3" Grid.Column="1" Style="{ThemeResource InfoValueStyle}" Margin="0,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System Usage Monitor -->
                <Border x:Name="MonitorBorder" Style="{ThemeResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Left: CPU -->
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock x:Name="CpuSensorLabel" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <Grid x:Name="CpuSensorGrid"/>
                            </StackPanel>

                            <!-- Right: GPU -->
                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <TextBlock x:Name="GpuSensorLabel" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <Grid x:Name="GpuSensorGrid"/>
                            </StackPanel>

                            <!-- Bottom: Memory + Fan -->
                            <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <TextBlock x:Name="MemorySensorLabel" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <Grid x:Name="MemorySensorGrid" Margin="0,0,0,8"/>
                                <TextBlock x:Name="FanSensorLabel" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <Grid x:Name="FanSensorGrid"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
