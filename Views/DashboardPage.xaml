<Page
    x:Class="VTStudioToolBox.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">

    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                <TextBlock x:Name="WelcomeText" Text=""
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </Border>

            <Border x:Name="LoadingBorder" Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <muxc:ProgressRing IsActive="True" Width="20" Height="20" Margin="0,0,16,0"/>
                    <TextBlock x:Name="LoadingText"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="HardwareInfoBorder" Grid.Row="3" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="HardwareInfoHeader" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LabelManufacturer" Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="HardwareManufacturerText" Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelMotherboard" Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="MotherboardText" Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelModel" Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="HardwareModelText" Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelCPU" Grid.Row="3" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="HardwareCPUText" Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelRAM" Grid.Row="4" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="RAMText" Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelGPU" Grid.Row="5" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="HardwareGPUText" Grid.Row="5" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelDisk" Grid.Row="6" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="HDDText" Grid.Row="6" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelNIC" Grid.Row="7" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="NetworkText" Grid.Row="7" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelAudio" Grid.Row="8" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="AudioText" Grid.Row="8" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelMonitor" Grid.Row="9" Grid.Column="0" Style="{StaticResource InfoLabelStyle}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="DisplayText" Grid.Row="9" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Margin="0,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="SystemInfoBorder" Grid.Row="4" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="SystemInfoHeader" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LabelName" Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="SystemComputerNameText" Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelSystem" Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="SystemInfoText" Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelInstallTime" Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="SystemInstallTimeText" Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock x:Name="LabelUptime" Grid.Row="3" Grid.Column="0" Style="{StaticResource InfoLabelStyle}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="SystemBootTimeText" Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Margin="0,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
