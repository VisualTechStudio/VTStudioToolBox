<Window
    x:Class="VTStudioToolBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="VTStudio ToolBox">

    <Grid x:Name="RootGrid" Background="Transparent">

        <Grid x:Name="EulaOverlay"
              Background="{ThemeResource EulaOverlayBrush}"
              Visibility="Collapsed"
              Canvas.ZIndex="100">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="24"
                        MaxWidth="700">

                <TextBlock Text="VTStudio ToolBox"
                           FontSize="56"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock x:Name="EulaText"
                           FontSize="20"
                           Foreground="{ThemeResource TertiaryTextBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <Button x:Name="BtnAgree"
                        Click="BtnAgree_Click"
                        Width="210"
                        Height="40"
                        FontSize="15"
                        FontWeight="Medium"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Background="{ThemeResource WindowBackgroundBrush}"/>

        <muxc:NavigationView x:Name="NavView"
                             PaneDisplayMode="Left"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="True"
                             IsPaneToggleButtonVisible="True"
                             PaneTitle="VTStudio ToolBox"
                             OpenPaneLength="200"
                             CompactPaneLength="56"
                             Background="Transparent"
                             Visibility="Collapsed">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="NavDashboard"
                                         Tag="dashboard"
                                         IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70A;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavUtilities"
                                         Tag="utilities">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavNetwork"
                                         Tag="network">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavHackintosh"
                                         Tag="macos">
                    <muxc:NavigationViewItem.Icon>
                        <ImageIcon Source="Assets/hackintosh.svg"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavAndroid"
                                         Tag="android">
                    <muxc:NavigationViewItem.Icon>
                        <ImageIcon Source="Assets/android.svg"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"
                   Margin="0,32,0,0"/>
        </muxc:NavigationView>
    </Grid>
</Window>
