<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">
            <!-- Colors -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CCCCCC"/>
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#BBBBBB"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#AAAAAA"/>
            <SolidColorBrush x:Key="DimTextBrush" Color="#888888"/>
            <SolidColorBrush x:Key="FaintTextBrush" Color="#999999"/>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#444444"/>
            <SolidColorBrush x:Key="LinkBlueBrush" Color="#4DA6FF"/>
            <SolidColorBrush x:Key="DangerRedBrush" Color="#FF6B6B"/>
            <SolidColorBrush x:Key="SectionBlueBrush" Color="#4FC3F7"/>
            <SolidColorBrush x:Key="SectionGreenBrush" Color="#81C784"/>
            <SolidColorBrush x:Key="SectionOrangeBrush" Color="#FFB74D"/>
            <SolidColorBrush x:Key="SectionPurpleBrush" Color="#BA68C8"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#4FC3F7"/>
            <SolidColorBrush x:Key="EulaOverlayBrush" Color="#CC1F1F1F"/>
            <SolidColorBrush x:Key="AvatarStrokeBrush" Color="White" Opacity="0.3"/>
            <!-- NavigationView overrides -->
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#CCCCCC"/>
            <SolidColorBrush x:Key="NavigationViewItemPointerOverForeground" Color="White"/>
            <SolidColorBrush x:Key="NavigationViewItemSelectedForeground" Color="White"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOverBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOverBrush" Color="#3D3D3D"/>
        </ResourceDictionary>

        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <!-- Colors -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#444444"/>
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#666666"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#777777"/>
            <SolidColorBrush x:Key="DimTextBrush" Color="#999999"/>
            <SolidColorBrush x:Key="FaintTextBrush" Color="#AAAAAA"/>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="LinkBlueBrush" Color="#0066CC"/>
            <SolidColorBrush x:Key="DangerRedBrush" Color="#D32F2F"/>
            <SolidColorBrush x:Key="SectionBlueBrush" Color="#1976D2"/>
            <SolidColorBrush x:Key="SectionGreenBrush" Color="#388E3C"/>
            <SolidColorBrush x:Key="SectionOrangeBrush" Color="#F57C00"/>
            <SolidColorBrush x:Key="SectionPurpleBrush" Color="#7B1FA2"/>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2"/>
            <SolidColorBrush x:Key="EulaOverlayBrush" Color="#CCF0F0F0"/>
            <SolidColorBrush x:Key="AvatarStrokeBrush" Color="Black" Opacity="0.3"/>
            <!-- NavigationView overrides -->
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="NavigationViewItemPointerOverForeground" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="NavigationViewItemSelectedForeground" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOverBrush" Color="#E8E8E8"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOverBrush" Color="#D8D8D8"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Page Header Styles -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Card Style -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Info Row Styles -->
    <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,4"/>
    </Style>

    <Style x:Key="InfoValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Section Header Style -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Tool Card Style (for UtilitiesPage) -->
    <Style x:Key="ToolCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

</ResourceDictionary>
